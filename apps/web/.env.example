# GitHub OAuth 配置
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# nuxt-auth-utils Session 加密密钥 (需至少 32 位字符)
NUXT_SESSION_PASSWORD=

# 后端 API 地址（生产环境在 Vercel 中设置为 https://tomogovo.foo/api）
NUXT_PUBLIC_API_BASE=http://localhost:3001

# 指定端口号（例如 3000 / 8080）
PORT=3002

# 如果需要支持局域网设备访问，可以配置 HOST
HOST=localhost

# 生产构建/Nitro 服务端专用端口变量（可选）
NITRO_PORT=3002
NITRO_HOST=localhost
